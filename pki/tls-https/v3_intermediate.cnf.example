# v3_intermediate.cnf
#
# OpenSSL v3 extensions for signing an Intermediate CA certificate.
# Used when the offline Root CA signs the Vault Intermediate CA CSR.
#
# Usage:
#   openssl x509 -req \
#     -in intermediate.csr \
#     -CA root-ca.crt -CAkey root-ca.key \
#     -CAcreateserial \
#     -out intermediate.crt \
#     -days 3650 -sha256 \
#     -extfile v3_intermediate.cnf \
#     -extensions v3_intermediate_ca
#
# Key constraints:
#   - CA:true        → this certificate can sign other certificates
#   - pathlen:0      → it CANNOT create sub-CAs (end-entity certs only)
#   - keyCertSign    → allowed to sign certificates
#   - cRLSign        → allowed to sign Certificate Revocation Lists
#
# Without these extensions, Vault will refuse to import the Intermediate
# with "non-CA certificate" and strict TLS clients will reject it.

[v3_intermediate_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true, pathlen:0
keyUsage = critical, digitalSignature, cRLSign, keyCertSign